# ============================================================
# ALEJANDRA APP - Variables de entorno / Cloudflare Secrets
# ============================================================
# Archivo de referencia (sin valores reales).
# NUNCA commitear secretos reales.
#
# Donde configurarlos:
# - Cloudflare Dashboard -> Workers -> <worker> -> Settings -> Variables and Secrets
# - O via CLI: npx wrangler secret put <NOMBRE> --name <worker>
#
# Workers:
# - Worker principal: alejandra-app-api (worker.js en raiz)
# - Worker agente:    alejandra-agente (alejandra-agente/worker.js)
# ============================================================

# ------------------------------------------------------------
# 1) Secrets compartidos (normalmente en ambos workers)
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GEMINI_API_KEY_2=AIza...
GEMINI_API_KEY_3=AIza...
GITHUB_TOKEN=github_pat_...
OPENROUTER_API_KEY=sk-or-...
RESEND_API_KEY=re_...
TELEGRAM_BOT_TOKEN=<token-botfather>
AGENT_INTERNAL_SECRET=<secret-interno-entre-workers>

# ------------------------------------------------------------
# 2) Solo worker principal (alejandra-app-api)
# ------------------------------------------------------------
ADMIN_CODE=<codigo-superadmin-interno>
DEV_CHAT_ID=<chat-id-desarrollador>
GOOGLE_CLIENT_EMAIL=<service-account>@<proyecto>.iam.gserviceaccount.com
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_PEDIDOS_SHEET_ID=<id-hoja-pedidos>
GOOGLE_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GOOGLE_SHEET_ID=<id-hoja-principal>
TAVILY_API_KEY=tvly-...
TELEGRAM_CHAT_ID=<chat-id-principal>
TELEGRAM_WEBHOOK_SECRET=<secret-webhook>
VAPID_PRIVATE_KEY=<clave-privada-vapid-base64url>
VAPID_PUBLIC_KEY=<clave-publica-vapid-base64url>

# ------------------------------------------------------------
# 3) Solo worker agente (alejandra-agente)
# ------------------------------------------------------------
ADMIN_TOKEN=<token-admin-panel-agente>
CLOUDFLARE_API_TOKEN=<token-cf-para-tools-deploy>
FIREBASE_CLIENT_EMAIL=<firebase-service-account-email>
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
OPENAI_API_KEY=sk-proj-...
RESEND_FROM=<email-remitente-opcional>
XAI_API_KEY=xai-...

# ------------------------------------------------------------
# 4) Variables legacy/opcionales detectadas en entorno actual
# ------------------------------------------------------------
FIREBASE_SERVER_KEY=<legacy-opcional>
GETAWAY_TOKEN=<legacy-opcional>

# ------------------------------------------------------------
# 5) Bindings (NO son secretos; van en wrangler.toml)
# ------------------------------------------------------------
# Worker principal:
#   DB      -> D1 alejandra-db
#   FILES   -> R2 alejandra-app-files
#
# Worker agente:
#   DB            -> D1 alejandra-db
#   FILES         -> R2 alejandra-app-files
#   API_WEB       -> service binding a alejandra-app-api
#   RATE_LIMIT_KV -> KV namespace de rate limiting
